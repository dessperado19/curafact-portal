  {
   "t": "p",
   "runs": [
    {
     "x": "Die bevollmächtigte Person ist berechtigt, die Beratungsstelle bei folgenden Handlungen im Rahmen der Beratungsbesuche nach § 37 Abs. 3 SGB XI zu vertreten:"
    }
   ]
  },
  {
   "t": "p",
   "runs": [
    {
     "x": "•  Abschluss und Unterzeichnung der Beratungsvereinbarung mit versicherten Personen bzw. deren gesetzlicher Vertretung,"
    }
   ]
  },
  {
   "t": "p",
   "runs": [
    {
     "x": "•  Aushändigung der Datenschutzinformation zum Beratungsbesuch,"
    }
   ]
  },
  {
   "t": "p",
   "runs": [
    {
     "x": "•  Unterzeichnung des Nachweises über den Beratungsbesuch als Beratungsperson."
    }
   ]
  },
  {
   "t": "p",
   "runs": [
    {
     "x": "§ 2 Nicht umfasst",
     "b": 1,
     "s": 11.0
    }
   ],
   "sb": 8.0,
   "sa": 3.0
  },
  {
   "t": "p",
   "runs": [
    {
     "x": "Nicht von der Vollmacht umfasst sind alle anderen Rechtsgeschäfte der Beratungsstelle, insbesondere Zahlungsfreigaben, Verträge mit Dritten, Änderungen der Vertretungsverhältnisse und die Erteilung weiterer Vollmachten. Von den Beschränkungen des § 181 BGB ist die bevollmächtigte Person nicht befreit."
    }
   ]
  },
  {
   "t": "p",
   "runs": [
    {
     "x": "§ 3 Dauer und Widerruf",
